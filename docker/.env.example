# AXIOM Local
LOCAL_MODE=true
CODE_EXECUTION_MODE=local
LOCAL_WORKSPACE_ROOT=./data/workspaces
LOCAL_EXECUTION_TIMEOUT_SECONDS=120

OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_LIST='["qwen/qwen3.7-flash"]'
# Models that accept OpenAI-compatible image_url input parts.
MULTIMODAL_MODELS='["qwen/qwen3.7-flash"]'
# OpenAI image detail level. Use low, high, or auto if your provider supports it.
MULTIMODAL_IMAGE_DETAIL=high
# Maximum bytes read from each declared image before it is included in a prompt.
MULTIMODAL_IMAGE_MAX_BYTES=8388608

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="data-intelligence"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

METHOD_HUB_MCP_URL=http://host.docker.internal:38000/mcp
MAX_AGENT_ITERATIONS=20
REPORT_DISCOVERY_MAX_ARTIFACTS=20
REPORT_DISCOVERY_MAX_ROUNDS=20
