# LAMBDA Local
LOCAL_MODE=true
DATABASE_URL=sqlite:///./data/lambda_local.db
FILE_STORAGE_MODE=local
CODE_EXECUTION_MODE=local
LOCAL_WORKSPACE_ROOT=./data/workspaces

# LLM configuration. Any OpenAI-compatible endpoint can be used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_LIST='["qwen/qwen3.7-flash"]'

# Optional LangSmith tracing for DiscoveryAgent and nested LangChain runs.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=gen-report
LANGSMITH_API_KEY=

# Local execution limits.
CODE_EXECUTION_TIMEOUT=900
MAX_OUTPUT_LENGTH=1000000

# Frontend dev server.
FRONTEND_URL=http://localhost:3000
